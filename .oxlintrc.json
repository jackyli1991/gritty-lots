{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "defineOptions": true,
    "defineProps": true,
    "defineEmits": true,
    "defineExpose": true,
    "withDefaults": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "vue/component-definition-name-casing": "error",
    "no-undef": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "vendor/**",
    "test/snapshots/**",
    "packages/*/dist/**",
    "apps/*/dist/**"
  ],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"]
}
