{
  "name": "gritty-lots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spellcheck": "cspell",
    "spellcheck:show": "cspell --show-suggestions",
    "dev": "pnpm --filter @gritty-lots/admin dev",
    "build": "pnpm --filter @gritty-lots/admin build",
    "preview": "pnpm --filter @gritty-lots/admin preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@cspell/dict-typescript": "^3.2.3",
    "@cspell/dict-vue": "^3.0.5",
    "@types/node": "^24.13.2",
    "@vue/tsconfig": "^0.9.1",
    "cspell": "^10.0.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.2"
  }
}
